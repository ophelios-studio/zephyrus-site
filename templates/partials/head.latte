{var $localePrefix = ($currentLocale ?? 'en') === ($defaultLocale ?? 'en') ? '' : '/' . $currentLocale}
{var $pagePath = isset($section) && isset($slug) ? '/' . $section . '/' . $slug . '/' : '/'}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="{$pageDescription ?? localize('common.meta_description')}">
<meta name="theme-color" content="#151b18">
<meta property="og:type" content="website">
<meta property="og:title" content="{if isset($section)}{$title} · Zephyrus{else}{localize('common.meta_title')}{/if}">
<meta property="og:description" content="{$pageDescription ?? localize('common.meta_description')}">
<meta property="og:locale" content="{$currentLocale === 'fr' ? 'fr_CA' : 'en_US'}">
<meta property="og:locale:alternate" content="{$currentLocale === 'fr' ? 'en_US' : 'fr_CA'}">
<meta property="og:site_name" content="Zephyrus">
<meta property="og:image" content="{$leafProductionUrl ?? ''}/assets/images/{$currentLocale === 'fr' ? 'og-fr' : 'og'}.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{$leafProductionUrl ?? ''}/assets/images/{$currentLocale === 'fr' ? 'og-fr' : 'og'}.png">
{if ($leafProductionUrl ?? '') !== ''}
<link rel="canonical" href="{$leafProductionUrl}{$localePrefix}{$pagePath}">
{foreach ['en', 'fr'] as $language}<link rel="alternate" hreflang="{$language}" href="{$leafProductionUrl}{$language === ($defaultLocale ?? 'en') ? '' : '/' . $language}{$pagePath}">{/foreach}
<link rel="alternate" hreflang="x-default" href="{$leafProductionUrl}{$pagePath}">
{/if}
<link rel="icon" type="image/svg+xml" href="{$leafBaseUrl}/assets/favicon.svg">
<link rel="preload" href="{$leafBaseUrl}/assets/fonts/space-grotesk-500.ttf" as="font" type="font/ttf" crossorigin>
<link rel="stylesheet" href="{$leafBaseUrl}/assets/css/site.css">
<link rel="stylesheet" href="{$leafBaseUrl}/assets/css/extensions.css">
<script defer src="{$leafBaseUrl}/assets/js/site.js"></script>
