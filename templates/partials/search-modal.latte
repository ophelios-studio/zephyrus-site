<dialog class="search-dialog" aria-label="{localize('common.search_label')}">
<div class="search-input-row"><svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="5.5" stroke="currentColor" stroke-width="1.5"/><path d="m12 12 5 5" stroke="currentColor" stroke-width="1.5"/></svg><input id="doc-search" type="search" placeholder="{localize('docs.search_placeholder')}" autocomplete="off" aria-label="{localize('docs.search_chapters')}"><button class="search-close" aria-label="{localize('docs.search_close')}">ESC</button></div>
<div class="search-results" aria-live="polite"></div><div class="search-hint"><span>{localize('docs.search_hint')}</span><span>{localize('docs.search_caption')}</span></div>
</dialog>
