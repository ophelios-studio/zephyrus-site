<section id="roadmap" class="roadmap-section section-pad" aria-labelledby="roadmap-title">
    <div class="section-label"><span class="eyebrow">{localize('roadmap.label')}</span><span class="mono">{localize('roadmap.caption')}</span></div>
    <div class="roadmap-grid">
        <div class="roadmap-copy" data-reveal>
            <span class="roadmap-status mono"><span class="status-dot"></span>{localize('roadmap.status')}</span>
            <h2 id="roadmap-title">Web3,<br><em>{localize('roadmap.title_accent')}</em></h2>
            <p>{localize('roadmap.body')}</p>
            <div class="roadmap-direction"><span class="mono">01 /</span><span>{localize('roadmap.direction')}</span></div>
        </div>
        <div class="contract-study" data-reveal>
            <div class="contract-study-header mono"><span>{localize('roadmap.study')}</span><span>PHP ↗ WEB3</span></div>
            <div class="contract-visual" aria-hidden="true">
                <svg class="contract-wire" viewBox="0 0 600 410" fill="none">
                    <path class="wire-grid" d="M0 340H600M0 270H600M0 200H600M0 130H600M100 0V410M200 0V410M300 0V410M400 0V410M500 0V410"/>
                    <path class="wire-path" d="M96 235H177C232 235 202 143 257 143H366M177 235C232 235 202 313 257 313H366"/>
                    <path class="wire-signal" d="M96 235H177C232 235 202 143 257 143H366"/>
                    <path class="wire-signal wire-signal-return" d="M366 313H257C202 313 232 235 177 235H96"/>
                    <circle cx="177" cy="235" r="4"/>
                </svg>
                <span class="php-port">&lt;?php</span>
                <div class="contract-stack">
                    <div class="contract-sheet sheet-back"><span class="mono">0x / 03</span><span class="contract-rule"></span><span class="contract-rule short"></span></div>
                    <div class="contract-sheet sheet-middle"><span class="mono">0x / 02</span><span class="contract-rule"></span><span class="contract-rule short"></span></div>
                    <div class="contract-sheet sheet-front"><div class="contract-sheet-top mono"><span>0x / 01</span><span>↗</span></div><span class="contract-glyph">{ }</span><span class="mono">{localize('roadmap.contract')}</span><span class="contract-rule"></span><span class="contract-rule short"></span></div>
                </div>
                <span class="contract-axis mono">{localize('roadmap.interface')}</span>
            </div>
            <div class="contract-study-footer"><span class="mono">{localize('roadmap.study_footer')}</span><span aria-hidden="true">↗</span></div>
        </div>
    </div>
    <div class="roadmap-note"><span class="mono">{localize('roadmap.note_label')}</span><p>{localize('roadmap.note')}</p></div>
</section>
