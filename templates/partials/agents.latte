<section id="agents" class="agents-section section-pad">
    <div class="section-label"><span class="eyebrow">06 / {localize('agents.label')}</span><span class="mono">{localize('agents.caption')}</span></div>
    <div class="agents-grid">
        <div class="agents-copy"><span class="agent-symbol" aria-hidden="true">[ Z ]</span><h2 data-reveal>{localize('agents.title')}<br><em>{localize('agents.title_accent')}</em></h2><p>{localize('agents.body')}</p><a class="inline-link" href="https://github.com/ophelios-studio/skills/tree/main/skills/zephyrus" target="_blank" rel="noopener">{localize('agents.read')} <span aria-hidden="true">↗</span></a></div>
        <div class="agent-guide" data-reveal>
            <div class="agent-guide-top"><span class="mono">{localize('agents.guide_title')}</span><span class="agent-ready"><span class="status-dot"></span>{localize('agents.ready')}</span></div>
            <div class="agent-scope"><span class="mono">{localize('agents.scope_label')}</span><p>{localize('agents.scope')}</p></div>
            <div class="agent-command"><div><span class="mono">{localize('agents.install')}</span><button class="copy-button" data-copy-target="skill-install-command" aria-label="{localize('agents.copy')}">{localize('ui.copy')} {include 'icon.latte', name: 'copy'}</button></div><pre><code id="skill-install-command">npx skills add ophelios-studio/skills --skill zephyrus</code></pre></div>
            <p class="agent-install-note">{localize('agents.install_note')}</p>
            <div class="agent-compatible"><span>Claude Code</span><span>Codex</span><span>Cursor</span><span>Gemini CLI</span></div>
            <a class="agent-standard-link" href="https://agentskills.io" target="_blank" rel="noopener">{localize('agents.standard')} <span aria-hidden="true">↗</span></a>
        </div>
    </div>
</section>
