<div id="ui-strings" hidden
    data-copy="{localize('ui.copy')}"
    data-copied="{localize('ui.copied')}"
    data-select-code="{localize('ui.select_code')}"
    data-copy-block="{localize('ui.copy_block')}"
    data-open-menu="{localize('ui.open_menu')}"
    data-close-menu="{localize('ui.close_menu')}"
    data-loading="{localize('ui.loading')}"
    data-search-error="{localize('ui.search_error')}"
    data-no-results="{localize('ui.no_results')}"
    data-start-section="{localize('docs.start')}"
    data-fundamentals-section="{localize('docs.fundamentals')}"
    data-pause="{localize('ui.pause')}"
    data-resume="{localize('ui.resume')}"
    data-pause-cta="{localize('ui.pause_cta')}"
    data-resume-cta="{localize('ui.resume_cta')}"
    data-live="{localize('ui.live')}"
    data-paused="{localize('ui.paused')}"></div>
