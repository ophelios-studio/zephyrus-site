{var $localePrefix = ($currentLocale ?? 'en') === ($defaultLocale ?? 'en') ? '' : '/' . $currentLocale}
<!DOCTYPE html>
<html lang="{$currentLocale ?? 'en'}">
<head>{block head}{include '../partials/head.latte'}{/block}</head>
<body class="landing-page" data-locale-prefix="{$localePrefix}">
{include '../partials/nav.latte'}
{block content}{/block}
<footer class="site-footer"><a class="brand" href="{$leafBaseUrl}{$localePrefix}/">{include '../partials/mark.latte'}<span>zephyrus.</span></a><p>{localize('common.footer_location')}</p><div><a class="ophelios-signature" href="https://ophelios.com" target="_blank" rel="noopener"><img src="{$leafBaseUrl}/assets/brands/ophelios-white.png" width="35" height="24" alt="" loading="lazy">{localize('common.footer_project')}{include '../partials/icon.latte', name: 'arrow-up-right'}</a><span>© {date('Y')}</span></div></footer>
<script defer src="{$leafBaseUrl}/assets/js/wind.js"></script>
<script defer src="{$leafBaseUrl}/assets/js/pixels.js"></script>
{include '../partials/ui-strings.latte'}
</body>
</html>
